# ==============================================================================
# GreenCampus Backend Configuration Template
# Copy this file to .env and customize for your local or production environment.
# NEVER commit real passwords or production secret keys to version control.
# ==============================================================================

# Project Metadata
PROJECT_NAME="GreenCampus API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (MySQL with PyMySQL driver)
# Format: mysql+pymysql://<username>:<password>@127.0.0.1:3306/<dbname>
DATABASE_URL=mysql+pymysql://<username>:<password>@127.0.0.1:3306/greencampus

# Security (JWT & Password Hashing - Phase 4)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (Image Storage - Phase 6)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
